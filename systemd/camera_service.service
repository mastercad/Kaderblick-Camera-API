[Unit]
Description=Arducam Camera Service
After=network.target
Requires=network.target

[Service]
Type=simple
User=kaderblick
Group=kaderblick
WorkingDirectory=/home/kaderblick/camera_api
Environment=VIRTUAL_ENV=/home/kaderblick/camera_api/venv
Environment=PATH=/home/kaderblick/camera_api/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/home/kaderblick/camera_api/venv/bin/python /home/kaderblick/camera_api/camera_service.py
Restart=on-failure
RestartSec=5
# Optional: avoid core dumps filling disk
LimitCORE=0
# Improve logging identification
SyslogIdentifier=camera_service

[Install]
WantedBy=multi-user.target
