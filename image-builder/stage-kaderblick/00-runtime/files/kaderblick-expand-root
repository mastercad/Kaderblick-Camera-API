#!/bin/bash
set -euo pipefail

STATE_FILE=/var/lib/kaderblick-root-expanded
root_partition=$(readlink -f "$(findmnt / -n -o SOURCE)")
root_name=$(basename "${root_partition}")
root_parent=$(lsblk -n -o PKNAME "${root_partition}")
root_disk="/dev/${root_parent}"
partition_number=$(cat "/sys/class/block/${root_name}/partition")

if [ -f "${STATE_FILE}" ]; then
  if grep -qx partition-expanded "${STATE_FILE}"; then
    resize2fs "${root_partition}"
    printf '%s\n' complete > "${STATE_FILE}"
    systemctl disable kaderblick-expand-root.service
  fi
  exit 0
fi

last_partition=$(parted "${root_disk}" -ms unit s print | tail -n 1 | cut -d: -f1)
if [ "${last_partition}" != "${partition_number}" ]; then
  echo "Root-Partition ist nicht die letzte Partition auf ${root_disk}." >&2
  exit 1
fi

partition_start=$(parted "${root_disk}" -ms unit s print \
  | awk -F: -v number="${partition_number}" '$1 == number {gsub(/s/, "", $2); print $2}')
if [ -z "${partition_start}" ]; then
  echo "Startsektor der Root-Partition konnte nicht bestimmt werden." >&2
  exit 1
fi

# fdisk schreibt die vergrößerte Partitionstabelle, kann aber einen Fehlercode
# liefern, weil die Tabelle des eingehängten Root-Datenträgers erst nach dem
# unmittelbar folgenden Neustart neu eingelesen werden kann.
printf 'p\nd\n%s\nn\np\n%s\n%s\n\np\nw\n' \
  "${partition_number}" "${partition_number}" "${partition_start}" \
  | fdisk "${root_disk}" || true

disk_size=$(parted "${root_disk}" -ms unit s print | head -n 2 | tail -n 1 | cut -d: -f2 | tr -d s)
partition_end=$(parted "${root_disk}" -ms unit s print \
  | awk -F: -v number="${partition_number}" '$1 == number {gsub(/s/, "", $3); print $3}')
if [ -z "${partition_end}" ] || [ "${partition_end}" -lt "$((disk_size - 2048))" ]; then
  echo "Root-Partition konnte nicht bis zum Datenträgerende erweitert werden." >&2
  exit 1
fi

printf '%s\n' partition-expanded > "${STATE_FILE}"
sync
systemctl --no-block reboot
