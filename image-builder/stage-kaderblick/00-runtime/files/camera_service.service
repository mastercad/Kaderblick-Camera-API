[Unit]
Description=Arducam Camera Service
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=kaderblick
Group=kaderblick
WorkingDirectory=/opt/kaderblick/camera_api/src
Environment=VIRTUAL_ENV=/opt/kaderblick/camera_api/venv
Environment=PATH=/opt/kaderblick/camera_api/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PYTHONPATH=/opt/kaderblick/camera_api/src
ExecStart=/opt/kaderblick/camera_api/venv/bin/python /opt/kaderblick/camera_api/src/camera_service.py
Restart=always
RestartSec=5
TimeoutStopSec=15
LimitCORE=0
SyslogIdentifier=camera_service

[Install]
WantedBy=multi-user.target
